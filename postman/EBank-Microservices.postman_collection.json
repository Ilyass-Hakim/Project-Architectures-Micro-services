{
  "info": {
    "name": "EBank Micro-services",
    "description": "Tests des micro-services via la Gateway (port 8888).\n\nOrdre de démarrage : Discovery (8761) → Customer (8081) → EBank (8082) → Gateway (8888).\nSwagger-UI : http://localhost:8081/swagger-ui.html et http://localhost:8082/swagger-ui.html",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:8888"
    },
    {
      "key": "eureka",
      "value": "http://localhost:8761"
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    }
  ],
  "item": [
